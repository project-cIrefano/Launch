DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# For local development, SQLite is the easiest option. On Vercel, use a
# persistent PostgreSQL database and set DATABASE_URL in the Vercel dashboard.
DATABASE_URL=
DB_ENGINE=sqlite

# Optional: enable the weather card and Groq-powered menu assistant.
OPENWEATHER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# For XAMPP MySQL, set DB_ENGINE=mysql and adjust these values.
# DB_ENGINE=mysql
# DB_NAME=taza_food_corner
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
